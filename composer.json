{
    "name": "druidfi/symfony-altcha-bundle",
    "description": "Altcha CAPTCHA integration for Symfony — form type, validator, and self-hosted/Sentinel support",
    "type": "symfony-bundle",
    "license": "MIT",
    "homepage": "https://github.com/druidfi/symfony-altcha-bundle",
    "require": {
        "php": ">=8.2",
        "altcha-org/altcha": "^2.0",
        "psr/cache": "^3.0",
        "symfony/dependency-injection": "^7.0|^8.0",
        "symfony/form": "^7.0|^8.0",
        "symfony/framework-bundle": "^7.0|^8.0",
        "symfony/http-foundation": "^7.0|^8.0",
        "symfony/http-kernel": "^7.0|^8.0",
        "symfony/routing": "^7.0|^8.0",
        "symfony/validator": "^7.0|^8.0"
    },
    "autoload": {
        "psr-4": {
            "Druidfi\\AltchaSymfony\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Druidfi\\AltchaSymfony\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "config": {
        "sort-packages": true
    }
}
